Connection_String=your_database_connection_string_here

JWT_SECRET_KEY=replace_with_strong_access_secret
JWT_REFRESH_SECRET_KEY=replace_with_strong_refresh_secret

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_EXPIRE_MINUTES=15

FRONTEND_URL=http://localhost:5173

# Redis cache, distributed locks, and audit stream settings.
REDIS_HOST=redis
REDIS_PORT=6379
LOG_LIMIT=100
LOG_TIMEOUT=5

# Upload storage and cleanup settings (physical files stored separately under files/Local, files/GDrive, files/Sharepoint).
UPLOAD_STORAGE_DIR=your_upload_storage_directory_here
UPLOAD_SESSION_TTL_SECONDS=3600
UPLOAD_CLEANUP_INTERVAL_SECONDS=300

# Cloud Provider Integration Credentials (v3 Architecture)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=your_redirect_url

MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=your_redirect_url
# AES-256-GCM encryption key (URL-safe base64 of 32 bytes). Required to encrypt provider refresh tokens.
# Example generation (python):
# >>> import base64, os
# >>> base64.urlsafe_b64encode(os.urandom(32)).decode()
ENCRYPTION_KEY=
# Optional email validation tuning.
EMAIL_CHECK_DELIVERABILITY=false
