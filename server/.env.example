Connection_String=your_database_connection_string_here

JWT_SECRET_KEY=replace_with_strong_access_secret
JWT_REFRESH_SECRET_KEY=replace_with_strong_refresh_secret

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_EXPIRE_MINUTES=15

FRONTEND_URL=http://localhost:5173

# Redis cache and distributed lock settings.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Upload storage and cleanup settings.
UPLOAD_STORAGE_DIR=D:/Zenteiq/Tasks/uploads
UPLOAD_SESSION_TTL_SECONDS=3600
UPLOAD_CLEANUP_INTERVAL_SECONDS=300

# Cloud Provider Integration Credentials (v3 Architecture)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=your_redirect_url

MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=your_redirect_url
# Optional email validation tuning.
EMAIL_CHECK_DELIVERABILITY=false
