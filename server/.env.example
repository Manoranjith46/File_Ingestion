# For Local Development
# ═══════════════════════════════════════════════════════════════════════════════
# 🗄️  DATABASE
# ══════════════════════════════════════════════════════════════════════════════

# PostgreSQL connection URI used by SQLAlchemy (e.g. postgresql://user:pass@host:5432/dbname).
Connection_String=YOUR_DB_CREDENTIALS

# ═══════════════════════════════════════════════════════════════════════════════
# 📮  REDIS (Cache, Locks & Audit Stream)
# ═══════════════════════════════════════════════════════════════════════════════

# Hostname or IP of the Redis server for caching, semaphores, and audit streams.
REDIS_HOST=REDIS_HOST

# Port the Redis server listens on.
REDIS_PORT=6379

# Maximum audit log entries to batch before flushing to the database.
LOG_LIMIT=100

# Seconds to wait before force-flushing a partial audit log batch.
LOG_TIMEOUT=5

# ═══════════════════════════════════════════════════════════════════════════════
# 🔐  AUTHENTICATION & JWT
# ═══════════════════════════════════════════════════════════════════════════════

# Secret key used to sign short-lived access tokens (HS256).
JWT_SECRET_KEY=YOUR_ACCESS_TOKEN

# Separate secret key used to sign long-lived refresh tokens.
JWT_REFRESH_SECRET_KEY=YOUR_REFRESH_TOKEN

# Minutes an access token remains valid before requiring refresh.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Days a refresh token remains valid before the user must re-login.
REFRESH_TOKEN_EXPIRE_DAYS=7

# Minutes a one-time password (OTP) code stays valid.
OTP_EXPIRE_MINUTES=10

# Minutes a password-reset link/token stays valid.
PASSWORD_RESET_EXPIRE_MINUTES=15

# Maximum concurrent login sessions allowed per user account.
MAX_ACTIVE_SESSIONS=5

# ═══════════════════════════════════════════════════════════════════════════════
# 🌐  APPLICATION SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════

# React frontend base URL — used for CORS allow_origins and OAuth redirect construction.
FRONTEND_URL=http://localhost:5173

# Whether to perform DNS/MX-record validation on user emails during registration.
EMAIL_CHECK_DELIVERABILITY=false

# ═══════════════════════════════════════════════════════════════════════════════
# 📁  UPLOAD STORAGE & CLEANUP
# ═══════════════════════════════════════════════════════════════════════════════

# Root directory where all uploaded/ingested files are physically stored on disk.
UPLOAD_STORAGE_DIR=YOUR_UPLOAD_DIR

# Seconds an incomplete chunked-upload session stays valid before being abandoned.
UPLOAD_SESSION_TTL_SECONDS=3600

# How often (seconds) the background scheduler scans for and deletes expired upload sessions.
UPLOAD_CLEANUP_INTERVAL_SECONDS=300

# Size of each chunk in the local chunked-upload flow (default: 5 MB).
CHUNK_SIZE_BYTES=5242880

PARTS_ROOT=.parts
FINAL_ROOT=files

LOCAL_STORAGE_DIR=Local
GDRIVE_STORAGE_DIR=GDrive
SHAREPOINT_STORAGE_DIR=Sharepoint

UPLOAD_SESSION_TTL_SECONDS=3600
UPLOAD_CLEANUP_INTERVAL_SECONDS=300

# ═══════════════════════════════════════════════════════════════════════════════
# 🔒  SECURITY & ENCRYPTION
# ═══════════════════════════════════════════════════════════════════════════════

# AES-256-GCM key (URL-safe base64 of 32 bytes) — encrypts cloud provider refresh tokens at rest.
# Generate with:  python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_FOR_AES(128)


# ═══════════════════════════════════════════════════════════════════════════════
# 🟢  GOOGLE DRIVE INTEGRATION
# ═══════════════════════════════════════════════════════════════════════════════

# OAuth 2.0 client ID from Google Cloud Console for GDrive file-picker auth.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# OAuth 2.0 client secret paired with the Google client ID.
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Callback URL Google redirects to after the user grants GDrive access.
GOOGLE_REDIRECT_URI=YOUR_GOOGLE_REDIRECT_URL
# ═══════════════════════════════════════════════════════════════════════════════
# 🔵  MICROSOFT / SHAREPOINT INTEGRATION
# ═══════════════════════════════════════════════════════════════════════════════

# Azure AD application (client) ID for SharePoint/OneDrive OAuth.
MICROSOFT_CLIENT_ID=YOUR_MICROSOFT_CLIENT_ID

# Azure AD client secret paired with the Microsoft client ID.
MICROSOFT_CLIENT_SECRET=YOUR_MICROSOFT_CLIENT_SECRET

# Azure AD tenant ID ("common" for multi-tenant, or a specific tenant GUID).
MICROSOFT_TENANT_ID=common

# Callback URL Microsoft redirects to after the user grants SharePoint access.
MICROSOFT_REDIRECT_URI=YOUR_MICROSOFT_REDIRECT_URL

# ═══════════════════════════════════════════════════════════════════════════════
# 📡  LOCAL FTP SERVER DAEMON (run_ftp_server.py)
#     Built-in pyftpdlib server that listens for incoming FTP uploads.
# ═══════════════════════════════════════════════════════════════════════════════

# Network interface the local FTP daemon binds to (0.0.0.0 = all interfaces).
FTP_SERVER_HOST=0.0.0.0

# Port the local FTP daemon listens on.
FTP_SERVER_PORT=21

# Username clients must use to authenticate to the local FTP server.
FTP_SERVER_USER=FTP_USERNAME

# Password clients must use to authenticate to the local FTP server.
FTP_SERVER_PASSWORD=FTP_SERVER_PASSWORD

# Public/external IP advertised in PASV (passive mode) responses for NAT'd clients.
# ADDRESS=0.0.0.0

# FTP Watcher Configuration
FTP_STORAGE_DIR=FTP
FTP_DROPZONE_PATH=YOUR_FTPZONE
FTP_POLL_INTERVAL_SECONDS=10
FTP_SAFETY_DELAY_SECONDS=5


# ═══════════════════════════════════════════════════════════════════════════════
# 🌍  EXTERNAL FTP PULL INGESTION (v3.3 — ext_ftp_service.py)
#     Server connects OUT to a remote FTP server and downloads files.
# ═══════════════════════════════════════════════════════════════════════════════

# Fernet symmetric key — encrypts external FTP passwords before storing in the Redis vault.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=YOUR_KEY

# Maximum /ftp/connect attempts allowed per user within the rate window.
FTP_CONNECT_RATE_LIMIT=5

# Sliding time window (seconds) for the connect rate limiter.
FTP_CONNECT_RATE_WINDOW_SECONDS=300

# Seconds of inactivity before Redis auto-expires and destroys stored FTP credentials.
FTP_SESSION_IDLE_TTL_SECONDS=1800

# Socket timeout (seconds) for the initial test connection to the remote FTP server.
FTP_PROBE_TIMEOUT_SECONDS=10





